# TEMPLATE ONLY: fill every required value before starting the relay.
# Keep the completed .env private (owner-only mode 0600); never commit it.
# Generate a fresh token with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BRIDGE_DEVICE_TOKEN=
# Required JSON argv for a real installed ACP stdio agent or external transport.
# Use single quotes around the complete JSON value. See README for SSH setup.
ACP_AGENT_COMMAND=
# Required absolute path on the AGENT host, not necessarily in the container.
ACP_WORKING_DIRECTORY=
# Optional administrator-owned ACP MCP descriptors; do not accept client config.
ACP_MCP_SERVERS='[]'

# Optional limits; these are the relay defaults.
# ACP_MAX_FRAME_BYTES=1048576
# ACP_STARTUP_SECONDS=20
# ACP_IDLE_SECONDS=300
# ACP_SESSION_SECONDS=3600
# ACP_IO_SECONDS=10
# ACP_TERMINATE_SECONDS=0.5
